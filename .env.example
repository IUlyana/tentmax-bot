# Create your bot using @BotFather and enable Business / Secretary Mode.
BOT_TOKEN=123456789:REPLACE_WITH_REAL_TOKEN
DATABASE_URL=postgresql://leads:leads_local_password@localhost:5432/leads

# Managers must write /start to the service bot at least once.
# Telegram IDs are numeric. Username is without @, used as a fallback contact link.
MANAGERS_JSON='[{"id":123456789,"name":"Анна","username":"anna_manager"},{"id":987654321,"name":"Иван","username":"ivan_manager"}]'

# Optional: Telegram ID for alerts when delivery to managers fails.
ADMIN_TELEGRAM_ID=

# Required for semantic answer checks. Enter the key securely; never commit it.
# OpenAI API billing is separate from a ChatGPT subscription.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini

# Optional: comma-separated personal Telegram IDs allowed to clear their own
# test questionnaire with /test_reset. Empty disables tester access.
# ADMIN_TELEGRAM_ID may also reset only their own questionnaire.
TESTER_TELEGRAM_IDS=
